// Estacionamento Hospitalar - modelo lógico (Projeto BD, iteração 2)
// Cole este código em https://dbdiagram.io/d
//
// Leitura dos relacionamentos:
//   >  muitos-para-um      -  um-para-um
//   ?  ao lado de uma tabela = aquele lado é opcional (participação parcial no DER)
//   sem ?                    = obrigatório (participação total no DER)

// ---------------------------------------------------------------- tipos

Enum tipo_cartao {
  MENSALISTA
  AVULSO
}

Enum status_cartao {
  ATIVO
  BLOQUEADO
  PERDIDO
}

Enum forma_pagamento {
  DINHEIRO
  CARTAO
  PIX
}

// ---------------------------------------------------------------- veículos

Table fabricante {
  cod_fabricante serial [primary key]
  nome_fabricante text [not null, unique]
}

Table modelo {
  cod_modelo serial [primary key]
  nome_modelo text [not null]
  cod_fabricante integer [not null]
}

Table categoria {
  cod_categoria serial [primary key]
  descricao text [not null, unique]
  isenta boolean [not null, default: false, note: 'true = veículo hospitalar/médico, não paga']
}

Table veiculo {
  placa char(7) [primary key]
  cor text
  ano smallint
  cod_modelo integer [not null]
  cod_categoria integer [not null]
  cod_cliente integer [note: 'só para veículos de mensalistas']
}

// ---------------------------------------------------------------- clientes e acesso

Table cliente {
  cod_cliente serial [primary key]
  nome text [not null]
  cpf char(11) [not null, unique]
  telefone "text[]" [note: 'multivalorado (array)']
  endereco endereco [note: 'composto: CREATE TYPE endereco (logradouro, numero, bairro, cidade, uf, cep)']
  Note: 'Cliente = mensalista. Uso avulso não é cadastrado como pessoa.'
}

Table cartao_acesso {
  num_cartao integer [primary key]
  tipo tipo_cartao [not null]
  status status_cartao [not null, default: 'ATIVO']
  data_emissao date [not null]
  data_validade date [note: 'só para cartão MENSALISTA']
  cod_cliente integer [note: 'obrigatório se MENSALISTA, vazio se AVULSO']
}

Table guarita {
  cod_guarita serial [primary key]
  localizacao text [not null]
}

Table estadia {
  cod_estadia serial [primary key]
  data_hora_entrada timestamp [not null]
  data_hora_saida timestamp [note: 'vazio enquanto o veículo está no pátio']
  num_cartao integer [not null]
  placa char(7) [not null]
  guarita_entrada integer [not null]
  guarita_saida integer
}

// ---------------------------------------------------------------- financeiro

Table pagamento {
  cod_pagamento serial [primary key]
  valor numeric(8,2) [not null]
  data_hora_pagamento timestamp [not null]
  forma_pagamento forma_pagamento [not null]
  cod_estadia integer [not null, unique, note: 'unique = relação 1:1']
  Note: 'Pagamento do uso avulso'
}

Table mensalidade {
  cod_mensalidade serial [primary key]
  mes_referencia date [not null]
  valor numeric(8,2) [not null]
  data_vencimento date [not null]
  data_pagamento date [note: 'vazio = ainda não pago']
  cod_cliente integer [not null]
  indexes {
    (cod_cliente, mes_referencia) [unique]
  }
  Note: 'Pagamento do mensalista'
}

// ---------------------------------------------------------------- grupos (cores no diagrama)

TableGroup veiculos [color: #2E7D32] {
  fabricante
  modelo
  categoria
  veiculo
}

TableGroup acesso [color: #1565C0] {
  cliente
  cartao_acesso
  guarita
  estadia
}

TableGroup financeiro [color: #C62828] {
  pagamento
  mensalidade
}

// ---------------------------------------------------------------- relacionamentos
// mesmos nomes dos losangos do DER

// todo modelo tem fabricante; fabricante pode ainda não ter modelo
Ref fabrica: modelo.cod_fabricante ?> fabricante.cod_fabricante

// todo veículo tem modelo e categoria
Ref instancia: veiculo.cod_modelo ?> modelo.cod_modelo
Ref classifica: veiculo.cod_categoria ?> categoria.cod_categoria

// opcional dos dois lados: veículo avulso não tem dono; cliente pode não ter veículo
Ref possui: veiculo.cod_cliente ?>? cliente.cod_cliente

// opcional dos dois lados: cartão avulso não tem dono
Ref recebe: cartao_acesso.cod_cliente ?>? cliente.cod_cliente

// toda estadia tem cartão, veículo e guarita de entrada
Ref utiliza: estadia.num_cartao ?> cartao_acesso.num_cartao
Ref realiza: estadia.placa ?> veiculo.placa
Ref registra_entrada: estadia.guarita_entrada ?> guarita.cod_guarita

// saída só é preenchida quando o veículo deixa o pátio
Ref registra_saida: estadia.guarita_saida ?>? guarita.cod_guarita

// 1:1 - todo pagamento é de uma estadia; estadia de mensalista ou isenta não gera pagamento
Ref gera: estadia.cod_estadia -? pagamento.cod_estadia

// toda mensalidade é de um cliente
Ref paga: mensalidade.cod_cliente ?> cliente.cod_cliente

// ---------------------------------------------------------------- dados de exemplo

Records fabricante(cod_fabricante, nome_fabricante) {
  1, 'Fiat'
  2, 'Volkswagen'
  3, 'Toyota'
  4, 'Mercedes-Benz'
  5, 'Honda'
}

